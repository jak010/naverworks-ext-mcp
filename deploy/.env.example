# NAVER WORKS Custom API Server 환경 설정 예시
# 필요한 항목만 주석을 해제하여 사용하세요.

# 서버 바인드 호스트 및 포트 (HOST 기본값: multi_user 모드 0.0.0.0, local 모드 127.0.0.1)
# HOST=0.0.0.0
PORT=9050

# 브라우저 교차 출처 호출 허용 Origin (쉼표 구분, 기본값: 없음 = 불허)
# CORS_ALLOW_ORIGINS=https://your-frontend.example.com

# 사용자(쿠키)별 / 서버 전체 네이버웍스 동시 요청 수
# NAVERWORKS_PER_USER_CONCURRENCY=4
# NAVERWORKS_UPSTREAM_CONCURRENCY=25

# 네이버웍스 설정
# DOMAIN_ID / INSTANCE_CODE 는 대체값입니다. ID를 받는 호출은 ID와 응답에서 자동으로 결정하고,
# ID가 없는 진입점(스페이스 목록·생성, OAuth 쿠키 검증)과 rl 확인 실패 시에만 이 값을 씁니다.
NAVERWORKS_BASE_URL=https://project.worksmobile.com
NAVERWORKS_DOMAIN_ID=300098158
NAVERWORKS_INSTANCE_CODE=24101

# 쿠키 저장 파일 경로 (기본값: ~/.config/naverworks/proj_cookies.txt)
# NAVERWORKS_COOKIE_JAR_PATH=~/.config/naverworks/proj_cookies.txt

# 인증 모드 (기본값: multi_user)
#  multi_user: 익명 다중 사용자 서비스. 각 사용자가 요청/세션마다 자신의 쿠키를 제공해야 함 (서버 쿠키 미사용)
#  local     : 본인 PC 단독 사용. 위 쿠키 파일 / NAVERWORKS_COOKIE 환경 변수를 기본 쿠키로 사용
# NAVERWORKS_AUTH_MODE=multi_user


# MCP 표준 OAuth 브라우저 로그인 (쿠키 없는 /mcp/rpc 요청에 401 → 클라이언트가 로그인 페이지를 엶, 기본값: true)
# NAVERWORKS_OAUTH_ENABLED=true
# 리버스 프록시 뒤에서 OAuth 메타데이터에 쓸 외부 주소
# PUBLIC_BASE_URL=https://naverworks-mcp.example.com
